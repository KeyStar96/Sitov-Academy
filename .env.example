# Public values are embedded at build time. No credentials belong in Git.
NEXT_PUBLIC_SITE_URL=https://217.154.228.254
SITE_URL=https://217.154.228.254
NEXT_PUBLIC_SUPABASE_URL=https://217.154.228.254/supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Private API for native server processes; never exposed to browsers.
SUPABASE_INTERNAL_URL=http://127.0.0.1:9080
SUPABASE_SERVICE_ROLE_KEY=

# Existing local Postfix server. No Resend or external mail API.
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_SECURE=false
SMTP_FROM="Sitov Academy <info@sitov-academy.com>"
# Set for an authenticated relay only:
# SMTP_USER=
# SMTP_PASS=

MAIL_WORKER_POLL_MS=5000

# Local speech synthesis daemon; match the token in tts.env.
LOCAL_TTS_URL=http://127.0.0.1:9070
LOCAL_TTS_TOKEN=

# Required: Internet -> Traefik -> Nginx -> loopback-only Next.js.
# Exactly one trailing proxy address in X-Forwarded-For is skipped (Traefik).
# Nginx app access is restricted to Traefik; no alternate public ingress.
TRUSTED_PROXY_HOPS=1
