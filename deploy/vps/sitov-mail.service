[Unit]
Description=Sitov Academy transactional SMTP outbox
After=network.target docker.service postfix.service
Wants=docker.service postfix.service

[Service]
Type=simple
User=sitov
Group=sitov
WorkingDirectory=/var/www/sitov-current
EnvironmentFile=/etc/sitov-academy/app.env
Environment=NODE_OPTIONS=--max-old-space-size=128
ExecStart=/usr/bin/node scripts/mail-worker.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
MemoryMax=256M
CPUQuota=25%
TasksMax=24
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
