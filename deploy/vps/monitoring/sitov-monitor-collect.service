[Unit]
Description=Sitov local status collection
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/sitov-monitor/collect.py
EnvironmentFile=-/etc/sitov-academy/monitor.env
Environment=PYTHONDONTWRITEBYTECODE=1
MemoryMax=64M
CPUQuota=25%
TasksMax=32
TimeoutStartSec=45
StateDirectory=sitov-monitor sitov-monitor-private
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
