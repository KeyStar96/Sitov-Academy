[Unit]
Description=Sitov Academy Next.js
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=sitov
Group=sitov
WorkingDirectory=/var/www/sitov-academy
EnvironmentFile=/etc/sitov-academy/app.env
Environment=NODE_OPTIONS=--max-old-space-size=1024
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
MemoryMax=1536M
CPUQuota=200%
TasksMax=128
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/sitov-academy/.next
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
